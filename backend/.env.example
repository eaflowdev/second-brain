# Copier en backend/.env et remplir les valeurs réelles. backend/.env est gitignoré.

# Clé gratuite sur https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# Modèles gratuits (suffixe :free) à vérifier sur https://openrouter.ai/models?max_price=0
GENERATION_MODEL=z-ai/glm-5.2:free
# Modèle avec support du tool calling natif (vérifier "tools" dans supported_parameters)
AGENT_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Clé gratuite sur https://tavily.com (recherche web pour l'agent)
TAVILY_API_KEY=
